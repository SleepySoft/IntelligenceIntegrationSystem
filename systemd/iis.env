# IIS 服务公共环境变量
# 路径以部署机器实际位置为准
PROJECT_DIR=/home/sleepy/Documents/IntelligenceIntegrationSystem
PYTHONPATH=/home/sleepy/Documents/IntelligenceIntegrationSystem

# 限制数值计算库线程数，避免在容器中抢占过多 CPU
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4

# 禁用 tokenizers 多进程警告
TOKENIZERS_PARALLELISM=false

# 禁用 CUDA（IIS 推理不需要 GPU）
CUDA_VISIBLE_DEVICES=
