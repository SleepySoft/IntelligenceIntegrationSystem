[Unit]
Description=Intelligence Integration System - Web Hub Service
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=sleepy
Group=sleepy
WorkingDirectory=/home/sleepy/Documents/IntelligenceIntegrationSystem
EnvironmentFile=/home/sleepy/Documents/IntelligenceIntegrationSystem/systemd/iis.env
# Codex CLI is installed per-user; system services do not inherit the login PATH.
Environment="PATH=/home/sleepy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStartPre=/home/sleepy/anaconda3/envs/iis/bin/python Scripts/deployment_preflight.py --component web
ExecStart=/home/sleepy/anaconda3/envs/iis/bin/python IntelligenceHubLauncher.py
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

# IIS 每 10 秒发送一次 WATCHDOG=1；30 秒未收到通知时重启。
NotifyAccess=main
WatchdogSec=30

KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
