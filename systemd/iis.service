[Unit]
Description=Intelligence Integration System - Web and Crawler (Legacy Aggregate Service)
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=sleepy
Group=sleepy
WorkingDirectory=/home/sleepy/Documents/IntelligenceIntegrationSystem
ExecStart=/home/sleepy/Documents/IntelligenceIntegrationSystem/launch_iis_system.sh
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
