[Unit]
Description=Generate the protected IIS traffic analytics report
After=nginx.service

[Service]
Type=oneshot
User=www-data
Group=adm
Environment=LC_ALL=C.UTF-8
ExecStart=/usr/local/sbin/update-iis-traffic-report
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/traffic-analytics
ReadOnlyPaths=/var/log/iis-traffic
